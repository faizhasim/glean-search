{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "glean-search",
  "title": "Glean Search",
  "description": "Search your company's knowledge base via Glean",
  "icon": "icon.png",
  "author": "faizhasim",
  "categories": [
    "Productivity",
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-glean",
      "title": "Search Glean",
      "description": "Search company docs via Glean CLI",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.25"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "platforms": [
    "macOS"
  ]
}
